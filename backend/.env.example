# =================================================================
# NEXORA PLATFORM — INDEPENDENT ENVIRONMENT CONFIGURATION
# =================================================================
ENVIRONMENT=development
PROJECT_NAME="Nexora — AI Employee Platform"
VERSION=0.1.0
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-this-super-secret-key-min-32-chars-for-nexora-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database Configuration (PostgreSQL / Supabase)
# For local zero-dependency testing, set: sqlite+aiosqlite:///./nexora.db
# For Supabase / Production PostgreSQL, use the asyncpg connection string:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexora_platform
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/nexora_platform

# Redis Distributed Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/1

# Document Ingestion & Storage
MAX_UPLOAD_SIZE_MB=25
STORAGE_ROOT=./uploads
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNKING_PROVIDER=local

# Embeddings & Vector Search (Qdrant)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=20
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=nexora_kb_

# RAG & Retrieval
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.05
RAG_MAX_CONTEXT_CHUNKS=5
CONVERSATION_HISTORY_MESSAGES=10
RETRIEVAL_MODE=dense
RERANKER_ENABLED=false

# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_TIMEOUT_SECONDS=60

# Voice AI Configuration
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
